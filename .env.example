# Postgres (Docker compose default — see docker-compose.yml)
DATABASE_URL="postgresql://stylesync:stylesync@localhost:5432/stylesync?schema=public"

# Scraping guards
SCRAPE_TIMEOUT_MS=12000
SCRAPE_MAX_BYTES=3000000
SCRAPE_USER_AGENT="Mozilla/5.0 (compatible; StyleSyncBot/1.0; +https://stylesync.app/bot)"

# Optional: set to "1" to force fallback mock extraction regardless of network
STYLESYNC_FALLBACK_ONLY=0
