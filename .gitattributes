# Normalize line endings: LF in the repo, native in the working copy.
* text=auto eol=lf

# Force LF on files that break when CRLF leaks in (scripts, lockfiles, configs).
*.sh          text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf
*.css         text eol=lf
*.html        text eol=lf
*.prisma      text eol=lf
Dockerfile    text eol=lf

# Binary — never normalize.
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.webp        binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.otf         binary
*.pdf         binary
